# ==== MySQL（系统库 ecogain + 认证库 ecogain_auth）====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecogain
MYSQL_PASSWORD=ecogain_pass
MYSQL_DATABASE=ecogain
MYSQL_AUTH_DATABASE=ecogain_auth

# ==== 服务地址 ====
# 本服务对外可达地址（OAuth 回调用）
PUBLIC_BASE_URL=http://localhost:8000
# 前端地址（登录成功/失败后 302 跳转目标）
FRONTEND_BASE_URL=http://localhost:5173
# 认证中心地址
AUTH_BASE_URL=http://localhost:8001

# ==== 文件与数据 ====
# 数据卷根目录：uploads/ exports/ workspace/ analytics/ 均在其下
DATA_DIR=./data

# ==== LLM（密钥只走环境变量，system_configs 存引用名 llm.api_key_ref）====
LLM_API_KEY=

# ==== OAuth2 服务间共享密钥 ====
# backend 换 token 用；与 auth-server 一致
AUTH_CLIENT_SECRET=ecogain-web-secret
# auth-server JWT 签名密钥（仅 auth-server 需要，backend 不自验 JWT）
AUTH_JWT_SECRET=change-me-in-prod

# ==== 运行环境 ====
TZ=Asia/Shanghai
