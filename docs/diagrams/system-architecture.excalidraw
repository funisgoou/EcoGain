    {"type": "text", "id": "llm_cfg_code", "x": 922, "y": 462, "width": 296, "height": 80, "text": "system_configs（热切换，免重启）\nllm.base_url / llm.model\nllm.api_key_ref（环境变量引用）\nPOST /api/admin/reload 即时生效", "originalText": "system_configs（热切换，免重启）\nllm.base_url / llm.model\nllm.api_key_ref（环境变量引用）\nPOST /api/admin/reload 即时生效", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200067, "version": 1, "versionNonce": 200068, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},
